{
    "name": "INIAD Plus - MOOCs PDF Helper",
    "short_name": "INIAD Plus",
    "version": "1.4.7",
    "manifest_version": 3,
    "description": "INIAD MOOCs \u306e\u8b1b\u7fa9\u30b9\u30e9\u30a4\u30c9\u306e\u5b66\u7fd2\u7528 PDF \u4f5c\u6210\u3001\u8ab2\u984c\u30fb\u51fa\u5e2d\u78ba\u8a8d\u3001Drive \u8cc7\u6599\u691c\u7d22\u3092\u88dc\u52a9\u3059\u308b\u975e\u516c\u5f0f Chrome \u62e1\u5f35\u3067\u3059",
    "homepage_url": "https://github.com/Kensuke-sam/iniad_plus",
    "permissions": [
        "storage"
    ],
    "optional_permissions": [
        "debugger",
        "downloads"
    ],
    "background": {
        "service_worker": "js/service-worker.js"
    },
    "icons": {
        "16": "img/iniadpp16.png",
        "48": "img/iniadpp48.png",
        "128": "img/iniadpp128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://moocs.iniad.org/*",
                "https://www.ace.toyo.ac.jp/ct/home*"
            ],
            "js": [
                "lib/jquery-3.7.1.min.js",
                "lib/jquery-ui-1.14.2.min.js",
                "lib/rgbcolor.js",
                "js/download-button.js",
                "js/colorchange.js",
                "js/backgroundchange.js",
                "js/background.js",
                "js/ace_json.js",
                "js/ace_json_button.js",
                "js/json_upload.js",
                "js/json_timetable_localstorage.js",
                "js/json_timetable.js",
                "js/moocs_assignment_tabs.js",
                "js/tools.js",
                "js/moocsmemo_btn.js",
                "js/scrolltop.js",
                "js/drive_buttons.js",
                "js/class_sort_button.js",
                "js/class_sort_default.js",
                "js/class_sort.js",
                "js/class_sort_reflect.js",
                "js/textarea_count.js",
                "js/header.js",
                "js/memolist.js",
                "js/slideoperate.js",
                "js/slide_question.js",
                "js/memonulldelete.js"
            ],
            "css": [
                "lib/jquery-ui-1.14.2.css",
                "css/download-button.css",
                "css/ace_dl.css",
                "css/json_upload.css",
                "css/mymemo.css",
                "css/scrolltop.css",
                "css/class_sort.css",
                "css/settingform.css",
                "css/slideoperate.css",
                "css/pointer.css",
                "css/dragover.css",
                "css/moocs_assignment_tabs.css",
                "css/theme01.css"
            ]
        },
        {
            "matches": [
                "https://docs.google.com/presentation/d/e/*"
            ],
            "js": [
                "lib/jquery-3.7.1.min.js",
                "js/download.js"
            ]
        }
    ]
}
